# ==============================================================================
# JobOS Environment Configuration Example
# Copy this file to .env and replace placeholder values with your configuration.
# Never commit the actual .env file with real secrets.
# ==============================================================================

# Database: PostgreSQL connection string (Required)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobos_dev?schema=public"

# Authentication: Auth.js / NextAuth secret key (Required)
# Generate a secure 32+ character random secret in production (e.g. `openssl rand -base64 32`)
AUTH_SECRET="development-secret-key-jobos-super-secure-change-in-prod"

# Application Base URL (Optional: defaults to http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"
PORT=3000

# AI Provider: Google Gemini API (Required for Phase 06+ JD Analysis & AI features)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# File Storage Provider: 'local' (default) or 's3' (Optional)
# In local mode, uploaded resumes are stored in ./uploads directory
FILE_STORAGE_DRIVER="local"

# Observability: Structured logging verbosity (Optional: 'debug' | 'info' | 'warn' | 'error')
LOG_LEVEL="info"
